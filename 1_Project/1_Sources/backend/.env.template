# Configuración de la aplicación base
# Copiar este archivo a .env y configurar los valores apropiados

# Entorno de ejecución (development, production)
APP_NODE_ENV="development"

# Versión de la aplicación
APP_VERSION="1_0_0"

# Configuración del servidor
APP_SERVER_PORT=5555
APP_SERVER_URL="0.0.0.0"

# Seguridad
APP_SEED="your-secret-seed-here"
APP_EXPIRATION_TOKEN="12H"
APP_EXPIRATION_TOKEN_RECOVERY="1H"

# Nombre del servicio
APP_SERVICE_NAME="app-base"

# Configuración de correo electrónico
APP_MAILER_HOST="smtp.gmail.com"
APP_MAILER_PORT=587
APP_MAILER_USER="your-email@example.com"
APP_MAILER_PASSWORD="your-email-password"

# Configuración de base de datos
APP_BD_HOST="localhost"
APP_BD_USER="root"
APP_BD_PASSWORD="your-database-password"
