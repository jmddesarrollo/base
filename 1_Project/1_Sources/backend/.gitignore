# Backend .gitignore

# ============================================
# Variables de Entorno
# ============================================
.env
.env.local
.env.*.local

# Mantener solo el template
!.env.template

# ============================================
# Dependencias
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Archivos Compilados
# ============================================
dist/
build/
*.js
*.js.map
*.d.ts
*.d.ts.map

# Excepciones: permitir archivos de configuración JS
!jest.config.js
!webpack.config.js

# TypeScript
*.tsbuildinfo

# ============================================
# Logs
# ============================================
logs/
*.log
data/logs/*.log

# Mantener estructura de carpetas
!data/logs/.gitkeep

# ============================================
# Archivos Temporales
# ============================================
*.tmp
*.temp
*.bak
tmp/
temp/

# ============================================
# Archivos Subidos
# ============================================
# Archivos subidos por usuarios
files/uploads/*
!files/uploads/.gitkeep

# Mantener archivos de template y recursos estáticos
!files/images/
!files/templates/
!files/sh/

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/
*.lcov

# ============================================
# IDEs
# ============================================
.vscode/
.idea/
*.swp
*.swo

# ============================================
# Sistema Operativo
# ============================================
.DS_Store
Thumbs.db

# ============================================
# Certificados y Claves
# ============================================
*.pem
*.key
*.cert
*.crt
ssl/
certs/

# ============================================
# Base de Datos
# ============================================
*.sqlite
*.sqlite3
*.db
